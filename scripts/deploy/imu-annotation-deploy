#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "用法：imu-annotation-deploy <部署包> <40位commit> <sha256>" >&2
  exit 2
fi

bundle=$1
release_id=$2
expected_sha256=$3
release_root=/opt/imu-annotation/releases
release_dir="${release_root}/${release_id}"
incoming="${release_root}/.incoming-${release_id}"
current_link=/opt/imu-annotation/current
config_path=/etc/imu-annotation/config.yaml
ready_marker="${release_dir}/.deployment-ready"
previous=""
python_root=/opt/imu-annotation/python
mapfile -t python_candidates < <(
  find "${python_root}" -mindepth 3 -maxdepth 3 -type f -executable \
    -path "${python_root}/cpython-3.12.*-linux-x86_64-gnu/bin/python3.12" \
    -print | sort -V
)

[[ ${bundle} =~ ^/tmp/imu-annotation-[0-9a-f]{40}\.tar\.gz$ ]] || {
  echo "部署包路径不符合白名单" >&2
  exit 2
}
[[ ${release_id} =~ ^[0-9a-f]{40}$ ]] || {
  echo "release_id 必须是 40 位小写 Git commit" >&2
  exit 2
}
[[ ${expected_sha256} =~ ^[0-9a-f]{64}$ ]] || {
  echo "SHA-256 格式无效" >&2
  exit 2
}
[[ -f ${bundle} ]] || {
  echo "部署包不存在" >&2
  exit 1
}
[[ ${#python_candidates[@]} -gt 0 ]] || {
  echo "没有找到可执行的 Python 3.12 受管补丁版本" >&2
  exit 1
}
managed_python=${python_candidates[$((${#python_candidates[@]} - 1))]}
python_version=$("${managed_python}" --version 2>&1)
[[ ${python_version} == Python\ 3.12.* ]] || {
  echo "受管 Python 版本不符合要求：${python_version}" >&2
  exit 1
}

preflight_release() {
  local candidate=$1
  [[ -x ${candidate}/.venv/bin/imu-annotation ]] || return 1
  runuser -u kscii -- "${candidate}/.venv/bin/python" -c \
    'from pathlib import Path; import sys; from imu_data_collector.config import load_settings; load_settings(Path(sys.argv[1]))' \
    "${config_path}"
}

actual_sha256=$(sha256sum "${bundle}" | cut -d ' ' -f 1)
[[ ${actual_sha256} == "${expected_sha256}" ]] || {
  echo "部署包 SHA-256 不匹配" >&2
  exit 1
}

while IFS= read -r entry; do
  [[ ${entry} != /* && ${entry} != ../* && ${entry} != */../* ]] || {
    echo "部署包包含不安全路径：${entry}" >&2
    exit 1
  }
done < <(tar -tzf "${bundle}")

mkdir -p "${release_root}" /var/lib/imu-annotation/cache
if [[ -L ${current_link} ]]; then
  previous=$(readlink -f "${current_link}")
fi

if [[ -d ${release_dir} && ! -f ${ready_marker} ]]; then
  [[ ${previous} != "${release_dir}" ]] || {
    echo "当前 release 缺少完成标记，拒绝原地重建" >&2
    exit 1
  }
  rm -rf -- "${release_dir}"
fi

if [[ ! -d ${release_dir} ]]; then
  rm -rf -- "${incoming}"
  mkdir -p "${incoming}"
  tar -xzf "${bundle}" --no-same-owner --no-same-permissions -C "${incoming}"
  chown -R kscii:kscii "${incoming}" /var/lib/imu-annotation
  mv "${incoming}" "${release_dir}"
  if ! runuser -u kscii -- /usr/local/bin/uv sync \
    --frozen --no-dev --project "${release_dir}" \
    --python "${managed_python}"; then
    rm -rf -- "${release_dir}"
    echo "受管虚拟环境安装失败，未切换 current" >&2
    exit 1
  fi
  if ! preflight_release "${release_dir}"; then
    rm -rf -- "${release_dir}"
    echo "新 release 入口、导入或配置预检失败，未切换 current" >&2
    exit 1
  fi
  printf '%s\n' "${release_id}" >"${ready_marker}"
  chmod -R a-w "${release_dir}"
fi

[[ $(<"${ready_marker}") == "${release_id}" ]] || {
  echo "release 完成标记无效" >&2
  exit 1
}
preflight_release "${release_dir}" || {
  echo "新 release 入口、导入或配置预检失败" >&2
  exit 1
}
if [[ -n ${previous} ]]; then
  preflight_release "${previous}" || {
    echo "当前私有配置与上一版本不兼容，无法保证失败回滚" >&2
    exit 1
  }
fi

install -m 0644 "${release_dir}/configs/systemd/imu-annotation.service" \
  /etc/systemd/system/imu-annotation.service
install -m 0644 "${release_dir}/configs/systemd/imu-annotation-gc.service" \
  /etc/systemd/system/imu-annotation-gc.service
install -m 0644 "${release_dir}/configs/systemd/imu-annotation-gc.timer" \
  /etc/systemd/system/imu-annotation-gc.timer

ln -s "${release_dir}" "${current_link}.next"
mv -Tf "${current_link}.next" "${current_link}"
systemctl daemon-reload
systemctl enable --now imu-annotation-gc.timer
systemctl restart imu-annotation.service

healthy=false
for _attempt in $(seq 1 20); do
  if curl --fail --silent http://127.0.0.1:8766/api/v1/health >/dev/null; then
    healthy=true
    break
  fi
  sleep 1
done

if [[ ${healthy} != true ]]; then
  if [[ -n ${previous} && -d ${previous} ]]; then
    ln -s "${previous}" "${current_link}.failed"
    mv -Tf "${current_link}.failed" "${current_link}"
    systemctl restart imu-annotation.service
  fi
  echo "新版本健康检查失败，已尝试切回上一版本" >&2
  exit 1
fi

rm -f -- "${bundle}"
echo "部署完成：${release_id}"
