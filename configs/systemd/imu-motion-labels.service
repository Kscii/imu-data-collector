[Unit]
Description=CPU motion annotation worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/imu-annotation/current/src/imu_data_collector/motion_label_worker.py

[Service]
Type=simple
User=kscii
Group=kscii
WorkingDirectory=/opt/imu-annotation/current
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/imu-annotation/current/.venv/bin/python -m imu_data_collector.motion_label_worker --config /etc/imu-annotation/config.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
UMask=0077
Nice=10
CPUQuota=100%
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/imu-annotation

[Install]
WantedBy=multi-user.target
